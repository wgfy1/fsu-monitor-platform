# ====================================
# FSU设备监控可视化平台 - 环境变量
# ====================================

# 后端配置
#
# ⚠️ NODE_ENV 不在这里设置：后端进程只读 backend/.env（dotenv 按工作目录查找），
#    本文件是 docker-compose 的变量替换模板。
#      · 本地开发 → 在 backend/.env 里写 NODE_ENV=development
#      · 生产部署 → docker-compose.yml 已固定 NODE_ENV=production，无需配置
#    后端未读到 NODE_ENV 时会**按生产环境处理**：MQTT_PASSWORD / JWT_SECRET
#    必须非空，否则拒绝启动。
#
# 服务器端口
PORT=3001

# 数据库路径
# 本文件是 Docker 部署用的环境变量模板；容器内的 DB_PATH 由 docker-compose.yml
# 固定为 /app/data/fsu.db，宿主机对应目录为 ./backend/data（不要在根目录建 data/）。
# 此处仅在使用 `npm run dev` 直接跑后端（工作目录为 backend/）时生效。
# DB_PATH=./data/fsu.db

# 离线判定阈值（分钟）
OFFLINE_THRESHOLD=10

# 每日数据清理
# 历史数据/已解决告警保留天数（默认 30 天，到期后每日自动删除）
DATA_RETENTION_DAYS=30
# 每日清理时间 HH:MM（默认 03:30，设备 5 秒级上报无真正低峰，凌晨影响最小）
DATA_CLEANUP_TIME=03:30

# 日志级别
LOG_LEVEL=info

# ====================================
# 上云部署配置说明
# ====================================
# 平台不提供 HTTP 推送接收接口：厂家 FSU 网关直接以 MQTT 连接平台 Broker 接入
# （mqtt://<公网IP或域名>:1883），请确认云服务器安全组已放行 1883 端口。
# 接入凭据见下方「MQTT 接入配置」与 FSU_LOGIN_USERNAME / FSU_LOGIN_PASSWORD 两项。
#
# HTTPS（推荐使用Nginx反向代理）只影响页面与 API 访问，不影响设备接入。
# 详见 README.md 中的上云部署步骤
# ====================================
# 账号认证配置
# ====================================
# JWT 密钥（生产环境必须修改！不配置则使用开发用默认值并在启动日志告警）
# 生成方式: openssl rand -hex 32
JWT_SECRET=

# Token 有效期（默认 7d）
JWT_EXPIRES_IN=7d

# 首次启动默认管理员（仅在 users 表为空时生效；生产环境请在首次启动前修改）
ADMIN_INITIAL_USERNAME=admin
ADMIN_INITIAL_PASSWORD=REPLACE_WITH_A_UNIQUE_STRONG_PASSWORD

# ====================================
# MQTT 接入配置（厂家协议 FSU 接入）
# ====================================
# 接入模式：固定 mqtt（厂家 FSU 协议为唯一正式接入方式）
CONNECT_MODE=mqtt

# 是否启用内置 MQTT Broker（true=内置 aedes；false=使用外部 Broker 如 Mosquitto）
EMBEDDED_BROKER=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ---- MQTT 统一账号（非一机一密）----
# 所有厂家 FSU 与平台内部客户端共用同一套账号密码，禁止匿名连接。
# MQTT_USERNAME 固定为 platform；MQTT_PASSWORD 只写在部署环境的 .env 中，
# 本示例文件与源码中一律不填真实密码。
MQTT_USERNAME=platform
MQTT_PASSWORD=

# 是否允许匿名连接（生产环境必须 false：禁止匿名 MQTT 连接）
MQTT_ALLOW_ANONYMOUS=false

# ====================================
# 厂家 FSU 网关协议（《网关MQTT通信协议》）
# ====================================
# 消息过期时间（秒）：协议 3.6 建议默认 3 秒；
# 接收方按消息 timestamp 过滤过期消息（login、ntp 不参与过滤）。
# 不配置时为 3。
MQTT_MESSAGE_EXPIRE_SECONDS=3

# 平台下行请求（getData/getAlarm/setData/reboot/ota）的响应超时（毫秒），默认 10000。
FSU_DOWNSTREAM_TIMEOUT_MS=10000

# ---------- 平台主动校时（协议 4.8 ntp，平台→网关）----------
# 现行策略：**设备上线时校时一次 + 在线期间按每台设备配置的间隔定时校时**。
#   报文体：{"id","timestamp","method":"ntp","code":0,"msg":"success"}
#           （不带 params、不带 data —— 即不更改网关时区）
#   该形状已在真实设备上验证有效；真实设备收到后**不回包**，
#   因此"发布成功"只代表平台把报文交给了 Broker，**不代表设备已校时**。
#
# 每台设备的配置（是否启用定时校时、间隔、最近/下次校时时间）保存在
# devices 表的 ntp_* 列，由前端「设备详情 → 校时设置」维护，**不需要在这里配置**。
# 间隔只允许 1 / 6 / 12 / 24 / 48 小时，默认 24 小时。
#
# ⚠️ 以下两个变量已**废弃**（旧版"消息过期触发校时"的配置，功能已整体移除）：
#      FSU_NTP_SYNC_COOLDOWN_SECONDS —— 不再是任何开关，设成 0 也不会关闭校时
#      FSU_NTP_TIMEZONE              —— 新报文不携带时区
#    生产 .env 中若仍有它们，可安全删除（保留也不会生效）。
#
# 下面的调度参数一般无需改动（仅在测试中覆盖）：
#   NTP_SCHEDULER_TICK_MS  调度器扫描周期，默认 30000（30 秒）
#   NTP_STARTUP_GRACE_MS   后端重启后的调度宽限，默认 60000（60 秒）内不执行定时校时
#   NTP_MIN_SEND_GAP_MS    同一设备两次校时的最小发送间隔，默认 10000（10 秒）

# 厂家协议 gw/v1/login 报文中 params.username / params.password 的认证凭据。
#
# ⚠️ 这是与 MQTT CONNECT 层**完全独立**的第二套认证，不要复用 MQTT 账号：
#      MQTT_USERNAME / MQTT_PASSWORD → MQTT 连接认证（平台统一账号 platform）
#      FSU_LOGIN_USERNAME / FSU_LOGIN_PASSWORD → FSU login 报文认证
#    厂家网关的 login 报文凭据通常与其 MQTT 账号不同（协议 Demo 为 admin/admin）。
#
# 未配置时按"失败关闭"处理：所有网关 login 一律返回 code=1，
# 并在服务启动时打印醒目告警（源码不内置任何默认账号）。
# 真实凭据请只写在部署环境的 .env 中，此处留空。
FSU_LOGIN_USERNAME=
FSU_LOGIN_PASSWORD=

# 是否强制校验 login 报文凭据（默认 true，必须保持开启）。
# 协议 4.1 规定认证失败返回 code=1。
# 仅可在本地排障时临时设为 false 放行（会打印告警），不可作为长期方案。
FSU_LOGIN_AUTH_ENFORCE=true

# ====================================
# 高德地图（首页「站点分布」真实地图）
# ====================================
# JS API Key 与安全密钥；不配置时首页地图区域显示占位，不影响其他功能。
# 申请地址: https://console.amap.com/dev/key/app
# 说明：前端在 Docker 镜像内构建，这两个值通过 build.args 注入，因此需写在本文件（构建时读取）
REACT_APP_AMAP_KEY=
REACT_APP_AMAP_SECURITY_CODE=

# ====================================
# 前端静态托管
# ====================================
# 前端构建产物目录（后端托管页面，单端口部署）。默认 <backend>/../frontend/build
# STATIC_DIR=../frontend/build
# Docker 部署时由 docker-compose.yml 设为 /app/frontend-build
