# ====================================
# 前端环境变量（CRA：必须以 REACT_APP_ 开头）
# 复制为 frontend/.env 后填写；.env 已被 .gitignore 忽略，不会提交
# ====================================

# ---- 高德地图 JS API（首页「站点分布」真实地图）----
# 申请地址: https://console.amap.com/dev/key/app
# 注意：JS API Key 是浏览器端公开密钥，请在控制台配置「域名白名单」做保护
REACT_APP_AMAP_KEY=

# 安全密钥（2021-12-02 之后申请的 Key 必须配置，否则地图不显示）
REACT_APP_AMAP_SECURITY_CODE=
