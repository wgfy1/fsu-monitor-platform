# ============================================================
# 运行环境：development / test / production
#
# ⚠️ 这里是**本地开发**用的示例文件，所以填 development。
#    生产环境**不要**改动这行 —— docker-compose.yml 的 environment 段已固定
#    NODE_ENV=production，其优先级高于 env_file，容器内始终按生产处理。
#
# ⚠️ 未设置或写成其它未知取值时，后端会**按生产环境处理**（fail-closed）：
#    必须配齐 MQTT_PASSWORD 与 JWT_SECRET，否则拒绝启动。
#    这样漏配 NODE_ENV 时不会带着源码里公开的默认口令对外服务。
# ============================================================
NODE_ENV=development

# 服务器端口
PORT=3001

# 数据库路径
DB_PATH=./data/fsu.db

# 接入模式：固定 mqtt（厂家 FSU 协议为唯一正式接入方式）
CONNECT_MODE=mqtt

# MQTT Broker 配置
# EMBEDDED_BROKER: 是否启用内置 MQTT Broker（true=内置，false=使用外部 Broker）
EMBEDDED_BROKER=true
MQTT_BROKER_HOST=localhost
MQTT_BROKER_PORT=1883

# ---- MQTT 统一账号（非一机一密）----
# 所有厂家 FSU 与平台内部客户端共用同一套账号密码。
# MQTT_USERNAME 固定为 platform；MQTT_PASSWORD 只放在部署环境自己的 .env 中，
# 不要写进本示例文件，也不要提交到 Git。
MQTT_USERNAME=platform
MQTT_PASSWORD=

# 是否允许匿名连接（生产环境必须 false：禁止匿名 MQTT 连接）
MQTT_ALLOW_ANONYMOUS=false

# ---- 登录令牌签名密钥 ----
# 生产环境**必须**显式配置且不得为空，否则后端拒绝启动（不会回退到源码里的
# 开发默认密钥 —— 那把密钥随源码公开，生效即等于任何人都能伪造管理员令牌）。
# 已部署的服务器：沿用现有值，不要重新生成，否则所有已登录会话会立即失效。
# 本地开发：development/test 下留空也可启动，会自动使用开发默认密钥并打印告警。
JWT_SECRET=

# 登录令牌有效期
JWT_EXPIRES_IN=7d

# 离线阈值（分钟）
OFFLINE_THRESHOLD=10

# 日志级别
LOG_LEVEL=info
